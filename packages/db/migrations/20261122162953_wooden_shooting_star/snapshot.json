      "op": "alter",
      "key": "checks\u0000[\"public\",\"extraction_attempts\",\"extraction_attempts_state_check\"]",
      "set": {
        "value": "\n    (\"status\" = 'running' and \"finished_at\" is null and \"duration_ms\" is null and \"result\" is null)\n    or (\"status\" in ('succeeded', 'failed') and \"finished_at\" is not null and \"duration_ms\" is not null and \"result\" is not null\n      and (\"result\"->>'version') = '1'\n      and ((\"status\" = 'succeeded' and \"result\"->>'status' = 'success') or (\"status\" = 'failed' and \"result\"->>'status' = 'error')))\n  "
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"price_checks\",\"price_checks_state_check\"]",
      "set": {
        "value": "\n    (\"status\" = 'pending' and \"started_at\" is null and \"finished_at\" is null and \"observation_id\" is null and \"error\" is null)\n    or (\"status\" = 'running' and \"workflow_id\" is not null and \"started_at\" is not null and \"finished_at\" is null and \"observation_id\" is null and \"error\" is null)\n    or (\"status\" = 'succeeded' and \"finished_at\" is not null and \"observation_id\" is not null and \"error\" is null)\n    or (\"status\" = 'failed' and \"finished_at\" is not null and \"observation_id\" is null and \"error\" is not null)\n    or (\"status\" = 'cancelled' and \"finished_at\" is not null and \"observation_id\" is null and \"error\" is null)\n  "
      }
    },
