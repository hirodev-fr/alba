# Aucune variable requise pour check/typecheck/test/build.
# Alchemy dev/provisionnement : profils Cloudflare et Neon, ou credentials serveur ci-dessous.
# Ne jamais renseigner ces valeurs côté navigateur.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# NEON_API_KEY=
# B04 : Alchemy provisionne Neon et injecte DATABASE_URL en secret dans API/Workflows.
# Après provisionnement, définir ici l’URL du projet personnel pour bun run db:test.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Futures intégrations métier (non branchées) :
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# B05/B06 : requis pour extraction:verify et extraction:benchmark --live ; jamais côté navigateur.
# ZYTE_API_KEY=
# B06 : lecture du coût réel via l’API Stats (clé Dashboard distincte).
# ZYTE_STATS_API_KEY=
# ZYTE_ORGANIZATION_ID=
# ZYTE_ORGANISATION_ID est également accepté.
