{
  "name": "alba",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "infra:plan": "alchemy plan --stage dev",
    "infra:deploy": "alchemy deploy --stage dev",
    "infra:dev": "alchemy dev",
    "infra:verify": "bun scripts/verify-infra.ts",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:test": "bun --env-file=.env test --timeout 30000 packages/tracking/tests/integration",
    "build:cloudflare": "bun run --cwd apps/web build:cloudflare",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "extraction:verify": "bun --env-file=.env scripts/verify-extraction.ts",
    "extraction:benchmark": "bun --env-file=.env scripts/benchmark-extraction.ts",
    "extraction:cost": "bun --env-file=.env scripts/benchmark-cost.ts",
    "dispatcher:verify": "bun --env-file=.env scripts/verify-dispatcher.ts",
    "workflow:verify": "bun --env-file=.env scripts/verify-workflow.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.87",
    "@alchemy.run/neon": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20261121.1",
    "@distilled.cloud/cloudflare": "1.0.0-rc.20",
    "@effect/platform-bun": "4.1.5",
    "@types/bun": "1.4.4",
    "alchemy": "2.0.0-beta.87",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "4.1.5",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "pg": "8.23.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "ultracite": "8.3.1"
  },
  "packageManager": "bun@1.4.4"
}
